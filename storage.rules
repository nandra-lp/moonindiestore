rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return signedIn() && userData().role == role;
    }

    function customerEmailVerified() {
      return signedIn()
        && (userData().get('requires_email_verification', false) != true
          || request.auth.token.email_verified == true);
    }

    function customerOwnsOrder(orderId) {
      return hasRole('customer')
        && customerEmailVerified()
        && firestore.get(
          /databases/(default)/documents/orders/$(orderId)
        ).data.uid_pelanggan == request.auth.uid;
    }

    function orderIsWaiting(orderId) {
      return firestore.get(
        /databases/(default)/documents/orders/$(orderId)
      ).data.status_order == 'menunggu';
    }

    function paymentCanBeSubmitted(orderId) {
      let order = firestore.get(
        /databases/(default)/documents/orders/$(orderId)
      ).data;
      return order.metode_pembayaran == 'bca'
        && order.status_order == 'diproses'
        && order.status_pembayaran in ['menunggu', 'bukti_dikirim'];
    }

    function validDesignUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
    }

    function validPaymentProofUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /produk/{fileName} {
      allow read: if true;
      allow create, update: if hasRole('admin')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasRole('admin');
    }

    match /desain/{orderId}/{fileName} {
      allow read: if hasRole('admin')
        || hasRole('owner')
        || customerOwnsOrder(orderId);
      allow create, update: if customerOwnsOrder(orderId)
        && orderIsWaiting(orderId)
        && validDesignUpload();
      allow delete: if hasRole('admin')
        || (customerOwnsOrder(orderId) && orderIsWaiting(orderId));
    }

    match /bukti-pembayaran/{orderId}/{uid} {
      allow read: if hasRole('admin')
        || hasRole('owner')
        || (request.auth.uid == uid && customerOwnsOrder(orderId));
      allow create, update: if request.auth.uid == uid
        && customerOwnsOrder(orderId)
        && paymentCanBeSubmitted(orderId)
        && validPaymentProofUpload();
      allow delete: if hasRole('admin');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
