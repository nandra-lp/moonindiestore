
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(myUid())
        )
        ? get(
            /databases/$(database)/documents/users/$(myUid())
          ).data.role
        : null;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isOwner() {
      return myRole() == 'owner';
    }

    function isCustomer() {
      return myRole() == 'customer';
    }

    // ==========================================
    // CUSTOMER OWNERSHIP
    // ==========================================

    function pelangganMilikSaya(idPelanggan) {
      return signedIn()
        && idPelanggan is string
        && exists(
          /databases/$(database)/documents/pelanggan/$(idPelanggan)
        )
        && get(
          /databases/$(database)/documents/pelanggan/$(idPelanggan)
        ).data.uid == myUid();
    }

    // Membaca order milik customer.
    function orderMilikCustomerRead(orderId) {
      let orderPath =
        /databases/$(database)/documents/orders/$(orderId);

      return isCustomer()
        && exists(orderPath)
        && pelangganMilikSaya(
          get(orderPath).data.id_pelanggan
        );
    }

    // Mendukung order yang dibuat dalam batch write.
    function orderMilikCustomerWrite(orderId) {
      let orderPath =
        /databases/$(database)/documents/orders/$(orderId);

      return isCustomer()
        && (
          (
            exists(orderPath)
            && pelangganMilikSaya(
              get(orderPath).data.id_pelanggan
            )
          )
          ||
          (
            existsAfter(orderPath)
            && pelangganMilikSaya(
              getAfter(orderPath).data.id_pelanggan
            )
          )
        );
    }

    // ==========================================
    // ORDER STATUS VALIDATION
    // ==========================================

    function orderMenunggu(orderId) {
      let orderPath =
        /databases/$(database)/documents/orders/$(orderId);

      return exists(orderPath)
        && get(orderPath).data.status_order == 'menunggu';
    }

    function orderMenungguAfter(orderId) {
      let orderPath =
        /databases/$(database)/documents/orders/$(orderId);

      return (
        exists(orderPath)
        && get(orderPath).data.status_order == 'menunggu'
      )
      ||
      (
        existsAfter(orderPath)
        && getAfter(orderPath).data.status_order == 'menunggu'
      );
    }

    // ==========================================
    // USERS
    // ==========================================

    match /users/{uid} {

      allow read: if signedIn()
        && (
          myUid() == uid
          || isAdmin()
        );

      // Registrasi hanya untuk customer.
      allow create: if signedIn()
        && myUid() == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == myUid();

      // Role hanya dapat dikelola admin.
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // PELANGGAN
    // ==========================================

    match /pelanggan/{id} {

      allow read: if isAdmin()
        || isOwner()
        || (
          isCustomer()
          && resource.data.uid == myUid()
        );

      allow create: if isAdmin()
        || (
          isCustomer()
          && request.resource.data.uid == myUid()
        );

      // Customer tidak dapat mengganti kepemilikan UID.
      allow update: if isAdmin()
        || (
          isCustomer()
          && resource.data.uid == myUid()
          && request.resource.data.uid == myUid()
        );

      allow delete: if isAdmin();
    }

    // ==========================================
    // PRODUK
    // ==========================================

    match /produk/{id} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // ORDERS
    // ==========================================

    match /orders/{id} {

      allow read: if isAdmin()
        || isOwner()
        || (
          isCustomer()
          && pelangganMilikSaya(
            resource.data.id_pelanggan
          )
        );

      // Customer hanya boleh membuat order menunggu.
      allow create: if isAdmin()
        || (
          isCustomer()
          && pelangganMilikSaya(
            request.resource.data.id_pelanggan
          )
          && request.resource.data.status_order == 'menunggu'
        );

      // Perubahan order hanya admin.
      allow update: if isAdmin();

      // Penghapusan permanen hanya admin.
      allow delete: if isAdmin();
    }

    // ==========================================
    // DETAIL ORDER
    // ==========================================

    match /detail_order/{id} {

      allow read: if isAdmin()
        || isOwner()
        || (
          isCustomer()
          && orderMilikCustomerRead(
            resource.data.id_order
          )
        );

      // Customer dapat membuat detail order
      // pada order miliknya yang masih menunggu.
      allow create: if isAdmin()
        || (
          request.resource.data.id_order is string
          && orderMilikCustomerWrite(
            request.resource.data.id_order
          )
          && orderMenungguAfter(
            request.resource.data.id_order
          )
        );

      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (
          orderMilikCustomerWrite(
            resource.data.id_order
          )
          && orderMenunggu(
            resource.data.id_order
          )
        );
    }

    // ==========================================
    // PRODUKSI
    // ==========================================

    match /produksi/{id} {

      allow read: if isAdmin()
        || isOwner()
        || (
          isCustomer()
          && orderMilikCustomerRead(
            resource.data.id_order
          )
        );

      // Pengelolaan produksi oleh admin.
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // TRACKING ORDER
    // ==========================================

    match /tracking_order/{id} {

      allow read: if isAdmin()
        || isOwner()
        || (
          isCustomer()
          && orderMilikCustomerRead(
            resource.data.id_order
          )
        );

      // Customer hanya dapat membuat tracking awal.
      allow create: if isAdmin()
        || (
          request.resource.data.id_order is string
          && orderMilikCustomerWrite(
            request.resource.data.id_order
          )
          && orderMenungguAfter(
            request.resource.data.id_order
          )
          && request.resource.data.status == 'Order dibuat'
        );

      // Pembaruan tracking hanya admin.
      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (
          orderMilikCustomerWrite(
            resource.data.id_order
          )
          && orderMenunggu(
            resource.data.id_order
          )
        );
    }

    // ==========================================
    // PERKIRAAN HARGA
    // ==========================================

    match /perkiraan_harga/{id} {

      allow read: if isAdmin()
        || isOwner()
        || (
          isCustomer()
          && pelangganMilikSaya(
            resource.data.id_pelanggan
          )
        );

      allow create: if isAdmin()
        || (
          isCustomer()
          && pelangganMilikSaya(
            request.resource.data.id_pelanggan
          )
        );

      allow update, delete: if isAdmin();
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
