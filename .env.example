# Firebase (client) — sudah terisi di .env.local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mis-db-1e50d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase Storage — bukti pembayaran saja
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Firebase Admin SDK untuk memverifikasi Firebase ID token
# Isi dengan JSON service account yang di-encode Base64. Jangan gunakan prefix NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Admin SDK (hanya untuk scripts/seed-users.mjs, JANGAN pakai prefix NEXT_PUBLIC_)
GOOGLE_APPLICATION_CREDENTIALS=D:/path/serviceAccount.json
