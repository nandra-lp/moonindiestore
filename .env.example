# Firebase (client) — sudah terisi di .env.local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mis-db-1e50d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare server-side proxy ke Firebase Cloud Function paymentProofApi.
# Isi dengan URL function setelah deploy; jangan gunakan prefix NEXT_PUBLIC_.
PAYMENT_PROOF_API_BASE_URL=

# Supabase browser client — publishable key only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin SDK (hanya untuk scripts/seed-users.mjs, JANGAN pakai prefix NEXT_PUBLIC_)
GOOGLE_APPLICATION_CREDENTIALS=D:/path/serviceAccount.json
